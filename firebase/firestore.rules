rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // ============================================
    // COLECCIONES PÚBLICAS (lectura sin autenticación)
    // ============================================
    
    // Tipos de visita - visible para todos, solo admins pueden escribir
    match /visitTypes/{visitTypeId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    
    // Horarios disponibles - visible para todos, solo admins pueden escribir
    match /schedules/{scheduleId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    
    // ============================================
    // COLECCIONES PROTEGIDAS (requieren autenticación)
    // ============================================
    
    // Usuarios - cada usuario puede leer/escribir su propio documento
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
      allow read: if isAdmin();
    }
    
    // Reservaciones - usuarios autenticados pueden crear, admins pueden leer todas
    match /reservations/{reservationId} {
      allow create: if request.auth != null;
      allow read, update: if request.auth != null && 
        (resource.data.userId == request.auth.uid || isAdmin());
      allow delete: if isAdmin();
    }
    
    // Suscripciones - usuarios autenticados pueden gestionar las suyas
    match /subscriptions/{subscriptionId} {
      allow create: if request.auth != null;
      allow read, update: if request.auth != null && 
        (resource.data.userId == request.auth.uid || isAdmin());
      allow delete: if isAdmin();
    }
    
    // ============================================
    // FUNCIONES HELPER
    // ============================================
    
    function isAdmin() {
      return request.auth != null && 
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }
    
    function isAuthenticated() {
      return request.auth != null;
    }
  }
}
